# ---- Python ----
__pycache__/
*.py[cod]
.venv/

# ---- 巨型词表资源(一次性下载,可从外部重新获取,不入仓库) ----
resources/ecdict.db
resources/ecdict-stardict-28.zip
resources/stardict-ecdict-2.4.2/

# ---- 可再生的 TTS 音频缓存(gen_audio.py 生成后已拷入 Anki collection.media) ----
data/output/*/anki/audio/

# ---- ide ----
.idea/

.zcode/

# ---- 系统杂项 ----
Thumbs.db
.DS_Store
# ---- EPUB→MD 转换缓存(epub_to_md.py 的 markitdown 原始输出,可重转) ----
data/books/_md/*_raw.md

# ---- AI 裁决中间缓存(ai_pick_proper.py 断点,可重跑恢复) ----
data/output/*/work/proper_ai_*.json

# ---- 重建期备份(旧产物快照,确认后可删) ----
data/output/_backup_*/
# ---- 手工打包的产物压缩包 ----
data/output.zip
